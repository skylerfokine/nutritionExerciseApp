# ================================
# Environment template (no secrets)
# Copy to .env and fill real values locally.
# Why: We keep secrets (passwords/keys) out of Git, but still show
# teammates exactly which settings the app expects.
# ================================

# ----- Server -----
PORT=3001                      # The port Express listens on in dev
NODE_ENV=development           # development | test | production
CLIENT_ORIGIN=http://localhost:5173
# Why CLIENT_ORIGIN: CORS needs to know which browser origin is allowed
# to send cookies to this API during development.

# ----- Database (MySQL) -----
DB_HOST=127.0.0.1              # MySQL host (127.0.0.1 for local)
DB_PORT=3306                   # Default MySQL port
DB_NAME=fitness_app_dev        # Dev schema name
DB_USER=dev_user               # Non-root user (least privilege)
DB_PASS=CHANGE_ME              # DO NOT commit the real password
DB_CONN_LIMIT=10               # Pool size; too big wastes connections
DB_TIMEZONE=Z                  # Store timestamps as UTC server-side
DB_CHARSET=utf8mb4             # Full Unicode (emoji-safe)

# ----- Sessions (server-side) -----
SESSION_COOKIE_NAME=app_session
# Why: Cookie name shown in the browser; scoped to this app only.

SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Why: Used by express-session to sign/encrypt cookie data. If leaked,
# attackers could forge sessions. Keep it secret; rotate if compromised.

SESSION_TTL_HOURS=24
# Why: How long a session should live before the user must re-auth.
# We also "roll" the cookie so active users extend their session.
